        <mxCell id="wo0u3d-V8i8jjWJqVI2R-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Oyun Akış Şeması&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; margin-bottom: 8px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal; font-size: 12px; line-height: 30%;&quot;&gt;Oyun içerisindeki seviye ve görev akış şeması karakterlerin hikayelerini &amp;amp; mekaniklerini tanıtmaya olanak sağlamak adına akış oluşturulmuştır&lt;/span&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;autosize=0;movableLabel=0;metaEdit=0;comic=0;arcSize=0;" parent="1" vertex="1">
